---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArtigoCard from '../../components/ArtigoCard.astro';
import { url } from '../../utils/url';

const artigos = (await getCollection('artigos', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf(),
);
---

<Base title="Artigos" description="Todos os artigos do Hojutsu.pt sobre armas, história e curiosidades.">
  <h1>Artigos</h1>
  <ul class="categorias">
    <li><a href={url('/artigos')} aria-current="page">Todos</a></li>
    <li><a href={url('/categoria/armas')}>Armas</a></li>
    <li><a href={url('/categoria/historia')}>História</a></li>
    <li><a href={url('/categoria/curiosidades')}>Curiosidades</a></li>
  </ul>
  {artigos.length === 0
    ? <p>Ainda não há artigos publicados.</p>
    : <div class="grelha">{artigos.map((artigo) => <ArtigoCard artigo={artigo} />)}</div>}
</Base>
